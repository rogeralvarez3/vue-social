# Servidor
PORT=4000
HTTP_REDIRECT_PORT=4080
NODE_ENV=development
CLIENT_URL=https://localhost:4000

# HTTPS (certificado local autofirmado, generado con scripts/generar-certificado.sh)
HTTPS_KEY_PATH=./certs/key.pem
HTTPS_CERT_PATH=./certs/cert.pem
# Poner en 'true' solo si corres detras de un proxy/balanceador que ya termina TLS
DISABLE_HTTP_REDIRECT=false

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=social_network
DB_USER=postgres
DB_PASSWORD=88280515@$

# JWT
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_largo_y_aleatorio
JWT_REFRESH_EXPIRES_DAYS=7

# Subida de imagenes
# Subida de imagenes/videos/documentos
# Estos limites aplican al archivo ORIGINAL antes de comprimir (ver src/utils/mediaProcessing.js).
# Las imagenes se re-escalan a maximo 1920x1080 y se recomprimen en JPEG calidad 82.
# Los videos se transcodifican siempre a MP4 (H.264/AAC, CRF 28, tipo de compresion de Facebook).
MAX_IMAGE_UPLOAD_MB=25
MAX_VIDEO_UPLOAD_MB=500
MAX_DOCUMENT_SIZE_MB=50
