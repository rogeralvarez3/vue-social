node_modules/
.env

# Certificados TLS: cada entorno debe generar/usar los suyos
certs/*.pem

# Imagenes/videos/documentos subidos por usuarios (mantener solo la estructura de carpetas)
uploads/avatars/*
uploads/posts/*
uploads/groups/*
uploads/media/*
uploads/documents/*
uploads/tmp/*
!uploads/avatars/.gitkeep
!uploads/posts/.gitkeep
!uploads/groups/.gitkeep
!uploads/media/.gitkeep
!uploads/documents/.gitkeep
!uploads/tmp/.gitkeep
